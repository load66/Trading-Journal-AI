# Runtime mode. Local defaults preserve the original local-first app.
APP_ENV=local
AUTH_MODE=disabled
DATABASE_MODE=sqlite
DATABASE_PATH=trading_journal.db
STORAGE_MODE=local
UPLOAD_DIR=uploads

# Hosted production (server-side only unless explicitly marked public).
# Production requires AUTH_MODE=supabase, DATABASE_MODE=turso, STORAGE_MODE=supabase.
AUTHORIZED_USER_ID=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=trading-journal-diary
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
FRONTEND_ORIGINS=

# Claude API key: powers diary analysis, day review, weekly summary, and Brain chat.
ANTHROPIC_API_KEY=
# Alpaca market-data key id: powers intraday price charts.
APCA_API_KEY_ID=
# Alpaca market-data secret key.
APCA_API_SECRET_KEY=
# Optional; defaults to iex. Use sip only with the paid market-data feed.
ALPACA_DATA_FEED=iex

# Browser/public GitHub Pages build values belong in frontend build environment,
# NOT this backend secret file:
# REACT_APP_AUTH_ENABLED=true
# REACT_APP_API_URL=https://your-service.onrender.com
# REACT_APP_SUPABASE_URL=https://your-project.supabase.co
# REACT_APP_SUPABASE_PUBLISHABLE_KEY=<publishable browser key>
