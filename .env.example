# Groq API key: primary provider for diary analysis and other supported AI reports
GROQ_API_KEY=
# Optional Groq model overrides
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Optional Anthropic fallback; still used by legacy Claude-only features such as Brain/weekly summary
ANTHROPIC_API_KEY=
# Alpaca market-data key id: powers the intraday price charts (free account at alpaca.markets)
APCA_API_KEY_ID=
# Alpaca market-data secret key
APCA_API_SECRET_KEY=
# Optional. Defaults to "iex", which works on a free Alpaca account. Set to "sip"
# only if your key has a paid market-data subscription.
ALPACA_DATA_FEED=

# Web deployment / authentication
# Local development remains unauthenticated unless AUTH_REQUIRED=true.
AUTH_REQUIRED=false
APP_ENV=development
SUPABASE_URL=
AUTHORIZED_USER_ID=

# Hosted database. Local development defaults to SQLite.
# DATABASE_URL is SERVER ONLY. In production use the Supabase Postgres
# session-pooler URL when the backend needs IPv4 connectivity.
DATABASE_MODE=sqlite
DATABASE_URL=

# Hosted private diary storage (Supabase secret key is SERVER ONLY)
STORAGE_MODE=local
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=diary

# Frontend public build-time configuration (safe to expose in browser)
REACT_APP_AUTH_REQUIRED=false
REACT_APP_API_URL=http://localhost:8010
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_PUBLISHABLE_KEY=

# Broker execution timestamp time zone for LE analysis.
TRADE_EXECUTION_TIMEZONE=America/Chicago

# BonusTracker Plaid fallback — disabled by default. SimpleFIN stays PRIMARY.
# Do not enter any PLAID values into frontend code or browser storage.
# Verify your Plaid Dashboard is on the FREE Trial plan, not a paid plan.
# The Trial allowance is 10 Production Items ever created across the entire
# Plaid team. /item/remove DOES NOT restore any allowance.
# NEVER apply for full Production access or perform a plan upgrade: doing so
# permanently removes Trial eligibility and may create subscription charges.
# Only set every gate below after verifying the real Plaid Dashboard, lifetime
# Item baseline, read-only transaction pipeline, and exact Tracker integration.
PLAID_TRIAL_ENABLED=false
PLAID_TRIAL_PLAN_VERIFIED=false
PLAID_TRIAL_BASELINE_CONFIRMED=false
PLAID_TRIAL_PIPELINE_READY=false
# Exact number of Production Items already created by this Plaid TEAM,
# including removed Items. Do NOT reset the encrypted lifetime counter.
PLAID_TRIAL_PRIOR_ITEMS=
PLAID_CLIENT_ID=
PLAID_SECRET=
